+            lowest_cross_rate: -1.0,
+            notional: 100,
+            ..base
+        })
+        .unwrap()
+        .value,
+        RateGridOutcome::RejectDiscountedFee(_)
+    ));
+    assert!(matches!(
+        validate_rate_grid_point(RateGridInput {
+            lowest_cross_rate: 0.0,
+            lowest_add_rate: -1.0,
+            notional: 10,
+            ..base
+        })
+        .unwrap()
+        .value,
+        RateGridOutcome::RejectNet(_)
+    ));
+    assert!(matches!(
+        validate_rate_grid_point(RateGridInput {
+            first_cross_rate: -1.0,
+            notional: 10,
+            ..base
+        })
+        .unwrap()
+        .value,
+        RateGridOutcome::RejectMaximumFee(_)
+    ));
+    assert!(matches!(
+        validate_rate_grid_point(RateGridInput {
+            lowest_cross_rate: 0.0,
+            lowest_add_rate: 0.0,
+            first_cross_rate: 1.0,
+            max_keep: 0.0,
+            notional: 1,
+            ..base
+        })
+        .unwrap()
+        .value,
